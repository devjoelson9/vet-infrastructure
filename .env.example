POSTGRES_USER=vet_user
POSTGRES_PASSWORD=vet_password

# Nomes das bases de dados individuais
POSTGRES_DB_IDENTIDADE=db_identidade
POSTGRES_DB_CLINICO=db_clinico
POSTGRES_DB_AGENDAMENTO=db_agendamento
POSTGRES_DB_FATURAMENTO=db_faturamento

# Portas dos Bancos para acesso local (Host -> Container)
POSTGRES_PORT_IDENTIDADE=5431
POSTGRES_PORT_CLINICO=5435
POSTGRES_PORT_AGENDAMENTO=5433
POSTGRES_PORT_FATURAMENTO=5434

# ==================================================
# MENSAGERIA (RabbitMQ)
# ==================================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ==================================================
# SEGURANÇA (JWT compartilhado entre os serviços)
# ==================================================
# O MESMO segredo deve ser usado por identidade, clínico e agendamento.
# Precisa ter no mínimo 32 bytes (256 bits).
JWT_SECRET=uma-chave-secreta-muito-longa-e-segura-para-hmac-sha256-com-pelo-menos-256-bits
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ==================================================
# REDE / FRONTEND
# ==================================================
CORS_ALLOWED_ORIGIN=http://localhost:8000
FRONTEND_URL=http://localhost:8000
MAIL_FROM=noreply@vet.local

# ==================================================
# API GATEWAY & REDE
# ==================================================
GATEWAY_PORT=8000

# Portas opcionais para acesso direto (docker-compose.override.yml)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
IDENTIDADE_PORT=8081
CLINICO_PORT=8082
AGENDAMENTO_PORT=8084
FATURAMENTO_PORT=8085